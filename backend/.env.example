# PostgreSQL connection.
# Option A: set the full URL directly (takes precedence if present).
# DATABASE_URL=postgresql://postgres:1234@localhost:5432/hotel_db

# Option B: set the individual settings (used when DATABASE_URL is unset).
POSTGRES_DB=hotel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
